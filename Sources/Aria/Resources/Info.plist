<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Oralis</string>
    <key>CFBundleDisplayName</key>
    <string>Oralis</string>
    <key>CFBundleIdentifier</key>
    <string>com.oralis.app</string>
    <key>CFBundleVersion</key>
    <string>3</string>
    <key>CFBundleShortVersionString</key>
    <string>3.1</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>NSMainStoryboardFile</key>
    <string></string>

    <!-- OAuth callback URL scheme — required for ASWebAuthenticationSession redirect -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.oralis.app</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>com.oralis.app</string>
            </array>
        </dict>
    </array>

    <!-- OAuth client IDs — fill in after registering apps in Google/Microsoft portals -->
    <key>GOOGLE_OAUTH_CLIENT_ID</key>
    <string>$(GOOGLE_OAUTH_CLIENT_ID)</string>
    <key>MICROSOFT_OAUTH_CLIENT_ID</key>
    <string>$(MICROSOFT_OAUTH_CLIENT_ID)</string>

    <!-- ElevenLabs TTS -->
    <key>ELEVENLABS_API_KEY</key>
    <string>$(ELEVENLABS_API_KEY)</string>
    <key>ELEVENLABS_PROXY_URL</key>
    <string>$(ELEVENLABS_PROXY_URL)</string>

    <!-- Privacy usage descriptions -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Oralis uses the microphone so you can control your email by voice.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>Oralis uses speech recognition so you can read, reply to, and manage emails hands-free.</string>
    <key>NSContactsUsageDescription</key>
    <string>Oralis reads your contacts to autocomplete email addresses.</string>
    <key>NSCalendarsUsageDescription</key>
    <string>Oralis reads your calendar so you can manage meeting invites by voice.</string>
    <key>NSAppleEventsUsageDescription</key>
    <string>Oralis imports accounts from macOS Mail with your permission.</string>
</dict>
</plist>
